{
  "name": "react-native-jankscope",
  "version": "0.1.0",
  "description": "Find out why each frame of a React Native app dropped, on Android and iOS, in release builds: JS thread, React Native mount work, other main-thread work, or render/GPU. Session reports, a live overlay, and a CLI that compares runs in CI.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "bin": {
    "jankscope": "bin/jankscope.js"
  },
  "author": "Moksh Upadhyay <mokshupadhyay4@gmail.com>",
  "homepage": "https://github.com/mokshupadhyay/react-native-jankscope#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokshupadhyay/react-native-jankscope.git"
  },
  "bugs": {
    "url": "https://github.com/mokshupadhyay/react-native-jankscope/issues"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "android/build.gradle",
    "android/src",
    "ios",
    "react-native-jankscope.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.map"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm test && npm run build",
    "example:install": "npm pack --pack-destination example && cd example && npm install ./react-native-jankscope-$npm_package_version.tgz",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "react-native",
    "performance",
    "jank",
    "frames",
    "fps",
    "hitch",
    "frame-metrics",
    "cadisplaylink",
    "profiling",
    "ci",
    "turbo-module",
    "new-architecture"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "codegenConfig": {
    "name": "RNJankscopeSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.jankscope"
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "fast-check": "^4.11.0",
    "jest": "^29.7.0",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-test-renderer": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
